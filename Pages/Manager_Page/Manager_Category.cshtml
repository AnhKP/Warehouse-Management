    <script src="../admin_template/assets/js/misc.js"></script>
    <script src="../admin_template/assets/js/settings.js"></script>
    <script src="../admin_template/assets/js/todolist.js"></script>
    <!-- endinject -->
    <!-- Custom js for this page -->
    <!-- End custom js for this page -->
</body>
</html>
