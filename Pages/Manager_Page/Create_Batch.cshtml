            <!-- partial -->
            <div class="main-panel">
                <div class="content-wrapper">
                    <div class="page-header">
                        <h3 class="page-title"> Create Batch </h3>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="#">Batch</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Create</li>
                            </ol>
                        </nav>
                    </div>
                    <div class="row">
                        <div class="col-md-8 grid-margin stretch-card mx-auto">
                            <div class="card">
                                <div class="card-body">
                                    <h3 class="card-title" style="color:crimson;    display: flex; justify-content: center">
                                        Create Batch
                                    </h3>
                                    <h5 class="card-description" style="color:yellow ; display: flex;
                                        justify-content: center">
                                        Please review the batch carefully before proceeding to the next step
                                    </h5>



                                    <form class="forms-sample" method="post">
                                        <!-- Batch Number -->
                                        <div class="form-group row">
                                            <label for="batchNumber" class="col-sm-3 col-form-label">Batch Number</label>
                                            <div class="col-sm-9">
                                                <input type="text" class="form-control" id="batchNumber" name="batchNumber" placeholder="Please enter batch number like BATCHXXX">
                                            </div>
                                        </div>

                                        <!-- Product Name -->
                                        <div class="form-group row">
                                            <label for="productName" class="col-sm-3 col-form-label">Product Name</label>
                                            <div class="col-sm-9">
                                                <select class="form-control" id="productName" name="productName">
                                                    @foreach (var pro in Model.products)
                                                    {
                                                        <option value="@pro.ProductId">@pro.ProductName</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>

                                        <!-- Manufacture Date -->
                                        <div class="form-group row">
                                            <label for="manufactureDate" class="col-sm-3 col-form-label">Manufacture Date</label>
                                            <div class="col-sm-9">
                                                <input type="date" class="form-control" id="manufactureDate" name="manufactureDate" placeholder="Please enter Manufacture date" >
                                            </div>
                                        </div>

                                        <!-- Expiry Date -->
                                        <div class="form-group row">
                                            <label for="expiryDate" class="col-sm-3 col-form-label">Expiry Date</label>
                                            <div class="col-sm-9">
                                                <input type="date" class="form-control" id="expiryDate" name="expiryDate" placeholder="Please enter expiry date">
                                            </div>
                                        </div>

                                        <!-- Quantity -->
                                        <div class="form-group row">
                                            <label for="quantity" class="col-sm-3 col-form-label">Quantity</label>
                                            <div class="col-sm-9">
                                                <input type="number" class="form-control" id="quantity" name="quantity" placeholder="Please enter quantity">
                                            </div>
                                        </div>

                                        <!-- Warehouse -->
                                        <div class="form-group row">
                                            <label for="warehouse" class="col-sm-3 col-form-label">Warehouse</label>
                                            <div class="col-sm-9">
                                                <input type="text" class="form-control" id="warehouse" name="warehouse" value="@Model.ware.WarehouseId" readonly>
                                            </div>
                                        </div>

                                        <!-- Supplier -->
                                        <div class="form-group row">
                                            <label for="supplier" class="col-sm-3 col-form-label">Supplier</label>
                                            <div class="col-sm-9">
                                                <select class="form-control" id="supplier" name="supplier">
                                                    @foreach (var supplier in Model.suppliers)
                                                    {
                                                            <option value="@supplier.SupplierId" >@supplier.SupplierName</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>



                                        <!-- Create Date -->
                                        <div class="form-group row">
                                            <label for="updateDate" class="col-sm-3 col-form-label">Create Date</label>
                                            <div class="col-sm-9">
                                                <input type="date" class="form-control" id="createDate" name="createDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" readonly>
                                            </div>
                                        </div>

                                        <!-- Status -->
                                        <div class="form-group row">
                                            <label class="col-sm-3 col-form-label">Status</label>
                                            <div class="col-sm-9">
                                                <div class="form-check form-check-warning">
                                                    <label class="form-check-label">
                                                        <input type="radio" class="form-check-input" name="status" value="5" checked> Pending
                                                    </label>
                                                </div>
                                                
                                            </div>
                                        </div>
                                        <!-- Submit and Cancel Buttons -->
                                        <div class="text-center">
                                            <input type="submit" class="btn btn-primary mr-2" value="Submit">
                                            <a href="Manager_Batch" class="btn btn-dark">Cancel</a>
                                        </div>

                                       





                                    </form>

                                    <style>
                                        input[readonly] {
                                            background-color: #e9ecef; /* Màu xám nhạt */
                                            color: #495057; /* Màu chữ tối hơn */
                                            opacity: 1; /* Đảm bảo độ trong suốt đầy đủ */
                                        }

                                    </style>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
