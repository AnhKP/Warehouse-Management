            <!-- partial -->
            <div class="main-panel">
                <div class="content-wrapper">
                    <div class="page-header">
                        <h3 class="page-title"> Batch Management </h3>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="#">Tables</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Batch </li>
                            </ol>
                        </nav>
                    </div>
                    <div class="row">
                        <div class="col-lg-12 grid-margin stretch-card mx-auto">
                            <div class="card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h2 class="card-title" style="font-weight: bold; color: #333;">Batch History 🚢🚢🚢</h2>
                                        <a class="btn btn-success" id="addBatchButton" href="Create_Batch">+ Add New Batch</a>
                                    </div>

                                    <div class="table-section">
                                        <div class="table-responsive">
                                            <table class="table table-custom">
                                                <thead>
                                                    <tr>
                                                        <th>#</th>
                                                        <th>Batch Number</th>
                                                        <th>Product Name</th>
                                                        <th>Manufacture Date</th>
                                                        <th>Expiry Date</th>
                                                        <th>Quantity</th>
                                                        <th>Warehouse Name</th>
                                                        <th>Supplier </th>
                                                        <th>PIC</th>
                                                        <th>Update Date</th>
                                                        <th>Status</th>
                                                        <th>Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var b in Model.batches)
                                                    {
                                                        <tr>
                                                            <td>@b.BatchId</td>
                                                            <td>@b.BatchNumber</td>
                                                            <td>@b.Product.ProductName</td>
                                                            <td>@b.ManufactureDate.Value.ToString("dd/MM/yyyy")</td>
                                                            <td>@b.ExpiryDate.Value.ToString("dd/MM/yyyy")</td>
                                                            <td>@b.Quantity</td>
                                                            <td>@b.Warehouse.WarehouseName</td>
                                                            <td>@b.Supplier.SupplierName</td>
                                                            <td>@(b.UserID == null ? string.Empty : b.User.FullName)</td>
                                                            <td>@(b.UpdateDate.HasValue ? b.UpdateDate.Value.ToString("dd/MM/yyyy") : string.Empty)</td>
                                                            <!-- Điều kiện để kiểm tra StatusId -->
                                                            <td class="@(b.StatusId == 5 ? "highlight-border" : string.Empty)">
                                                                @b.Status.StatusName
                                                            </td>
                                                            <td>
                                                                <button class="btn-action btn-update">
                                                                    <a asp-page="/Manager_Page/Update_Batch" asp-route-bid="@b.BatchId" style="color:white">Update</a>
                                                                </button>
                                                                <button class="btn-action btn-delete">Delete</button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>

                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <style>
                    /* Nền chung */
                    .card {
                        background-color: burlywood; /* Nền sáng cho bảng */
                        color: #333; /* Màu chữ đậm để dễ đọc */
                        border-radius: 8px;
                        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
                        padding: 20px;
                    }

                    h2.card-title {
                        font-weight: bold;
                        font-size: 1.5rem;
                        color: #444; /* Màu chữ nhẹ hơn nhưng vẫn rõ ràng */
                    }

                    /* Nút "Add New Batch" */
                    .btn-success {
                        font-size: 1rem;
                        font-weight: bold;
                        padding: 10px 20px;
                        background-color: #28a745;
                        color: #fff;
                        border-radius: 5px;
                        text-decoration: none;
                        border: none;
                        transition: background-color 0.2s;
                    }

                        .btn-success:hover {
                            background-color: #218838;
                        }

                    /* Bảng */
                    .table-custom {
                        width: 100%;
                        border-collapse: collapse;
                        font-family: Arial, sans-serif;
                        color: #333;
                        margin-top: 15px;
                    }

                        .table-custom thead {
                            background-color: #e9ecef;
                            color: #495057;
                            font-style: normal;
                        }

                        .table-custom th, .table-custom td {
                            padding: 12px;
                            border: 1px solid #dee2e6;
                            text-align: center;
                        }

                        .table-custom th {
                            font-weight: 600;
                            font-size: 0.9rem;
                        }

                        .table-custom tbody tr:nth-child(even) {
                            background-color: #f8f9fa;
                        }

                        .table-custom tbody tr:hover {
                            background-color: #e2e6ea;
                        }

                    /* Nút hành động */
                    .btn-action {
                        font-size: 0.9rem;
                        color: #ffffff; /* Màu chữ trắng để nổi bật */
                        padding: 5px 12px;
                        margin: 0 3px;
                        border: none;
                        border-radius: 4px;
                        cursor: pointer;
                        transition: background-color 0.2s;
                    }

                        /* Nút Update và Delete với màu sắc rõ ràng */
                        .btn-action.btn-update {
                            background-color: #007bff; /* Màu xanh đậm cho nút Update */
                        }

                        .btn-action.btn-delete {
                            background-color: #dc3545; /* Màu đỏ cho nút Delete */
                        }

                        /* Hiệu ứng khi rê chuột lên nút */
                        .btn-action:hover {
                            opacity: 0.9;
                        }
                    /* Viền vàng cho trạng thái đặc biệt */
                    .highlight-border {
                        border: 2px solid #ffc107; /* Màu vàng */
                        padding: 8px;
                        border-radius: 4px; /* Bo góc cho đẹp */
                        font-weight: bold;
                    }


                </style>
                <!-- content-wrapper ends -->
                <!-- partial:../admin_template/partials/_footer.html -->
                <footer class="footer">
                    <div class="d-sm-flex justify-content-center justify-content-sm-between">
                        <span class="text-muted d-block text-center text-sm-left d-sm-inline-block">Copyright © FreshTrack 2024</span>
                    </div>
                </footer>
